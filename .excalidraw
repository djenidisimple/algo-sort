      "link": null,
      "locked": false,
      "text": "i = 0, j = 1\ntab[i] > tab[i+1]:\nexchange tab \ntab[i], tab[i+1] = tab[i+1], tab[i]\nfor i in range(len(array) - 1):\n    j = i + 1\n    while j > 0:\n        if tab[j-1] > tab[j]:\n            tab[j-1], tab[j] = tab[j], tab[j-1]\n        j -= 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i = 0, j = 1\ntab[i] > tab[i+1]:\nexchange tab \ntab[i], tab[i+1] = tab[i+1], tab[i]\nfor i in range(len(array) - 1):\n    j = i + 1\n    while j > 0:\n        if tab[j-1] > tab[j]:\n            tab[j-1], tab[j] = tab[j], tab[j-1]\n        j -= 1",
      "autoResize": true,
      "lineHeight": 1.25
